{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    },
    "color": {
      "1": "#63c7d2",
      "2": "#63c6cb"
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "#bec7d2",
      "title": "#c4c6cb"
    },
    "percent": {
      "color": {
        "green": "#d0c2d0",
        "yellow": "#bec7d2",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "----------------------------------------"
    },
    {
      "type": "os",
      "key": "OS          ",
      "keyColor": "31"
    },
    {
      "type": "kernel",
      "key": "Kernel      ",
      "keyColor": "32"
    },
    {
      "type": "uptime",
      "key": "Uptime      ",
      "keyColor": "33"
    },
    {
      "type": "packages",
      "key": "Packages    ",
      "keyColor": "34"
    },
    {
      "type": "shell",
      "key": "Shell       ",
      "keyColor": "35"
    },
    {
      "type": "wm",
      "key": "WM          ",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": "Terminal    ",
      "keyColor": "32"
    },
    {
      "type": "cpu",
      "key": "CPU         ",
      "keyColor": "31"
    },
    {
      "type": "gpu",
      "key": "GPU         ",
      "keyColor": "33"
    },
    {
      "type": "memory",
      "key": "Memory      ",
      "keyColor": "35"
    },
    {
      "type": "custom",
      "format": "----------------------------------------"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
